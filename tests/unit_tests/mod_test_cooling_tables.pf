  subroutine test_cooling_curve_Colgan_below()
    call set_name("cooling curve: Colgan (below Tmin)")
    call set_cooling_curve("Colgan")
    call allocate_arrays(pts=100)
    T0vals = linspace(1.0d0, 95.0d0, 100) / unit_temperature
