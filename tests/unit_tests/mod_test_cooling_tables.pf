    call set_cooling_curve("DM_2")
    call allocate_arrays(pts=100)
    T0vals = linspace(1.1d9, 1.0d10, 100) / unit_temperature
    expected = get_brehmstrahlung_lambda(T0vals, logT_DM_2, logL_DM_2)
    actual = get_dLdrho()
    @assertEqual(expected, actual, tolerance=TOL)
    expected = get_brehmstrahlung_dlambda(T0vals, logT_DM_2, logL_DM_2)
    actual = get_dLdT()
    @assertEqual(expected, actual, tolerance=TOL)
  end subroutine test_cooling_curve_DM_2_above


  @test
  subroutine test_cooling_curve_DM_2()
    call set_name("cooling curve: DM_2")
    call set_cooling_curve("DM_2")
    call allocate_arrays(pts=41)
    T0vals = 10.0d0 ** logT_DM_2(20:60) / unit_temperature
    expected = 10.0d0 ** logL_DM_2(20:60) / unit_lambdaT
    actual = get_actual(physics%heatloss%cooling%lambdaT)
    @assertEqual(expected, actual, tolerance=2.0d-1)
  end subroutine test_cooling_curve_DM_2


