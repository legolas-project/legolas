    call allocate_arrays(pts=41)
    T0vals = 10.0d0 ** logT_Colgan(10:50) / unit_temperature
    expected = 10.0d0 ** logL_Colgan(10:50) / unit_lambdaT
    actual = get_actual(physics%heatloss%cooling%lambdaT)
